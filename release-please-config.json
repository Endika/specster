{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "specster",
      "extra-files": [
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='specster')].version" },
        { "type": "generic", "path": "action.yml" },
        { "type": "generic", "path": "src/specster/__init__.py" }
      ]
    }
  }
}
